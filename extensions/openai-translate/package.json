      "label": "Auto Input Selected Text",
      "description": "Automatically input selected text when opening the extension",
      "required": false,
      "type": "checkbox",
      "default": true
    },
    {
      "name": "defaultAction",
      "title": "Default Action",
      "description": "Default action when pressing Enter on a translation result",
      "required": false,
      "type": "dropdown",
      "default": "copy",
      "data": [
        { "title": "Copy to Clipboard", "value": "copy" },
        { "title": "Paste to Active App", "value": "paste" }
      ]
    },
    {
      "name": "translationStyle",
      "title": "Translation Style",
      "description": "Style of translation output",
      "required": false,
      "type": "dropdown",
