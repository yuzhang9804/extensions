{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "openai-translate",
  "title": "OpenAI Translate",
  "description": "AI-powered translation using OpenAI GPT models with natural, context-aware results",
  "icon": "openai-translate.png",
  "author": "yuzhang9804",
  "categories": [
    "Web",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "translate",
      "title": "Translate",
      "subtitle": "OpenAI Translate",
      "description": "AI-powered translation via OpenAI",
      "mode": "view"
    },
    {
      "name": "translate-form",
      "title": "Translate Form",
      "subtitle": "OpenAI Translate",
      "description": "AI-powered translation via OpenAI with form input",
      "mode": "view"
    },
    {
      "name": "quick-translate",
      "title": "Quick Translate",
      "subtitle": "OpenAI Translate",
      "description": "Quickly translate to multiple languages",
      "mode": "view"
    },
    {
      "name": "instant-translate-copy",
      "title": "Instant Translate Copy",
      "subtitle": "OpenAI Translate",
      "description": "Instantly translate selected text and copy to clipboard",
      "mode": "no-view"
    },
    {
      "name": "instant-translate-paste",
      "title": "Instant Translate Paste",
      "subtitle": "OpenAI Translate",
      "description": "Instantly translate selected text and paste to active app",
      "mode": "no-view"
    },
    {
      "name": "instant-translate-view",
      "title": "Instant Translate View",
      "subtitle": "OpenAI Translate",
      "description": "Instantly translate selected text with HUD display",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "OpenAI API Key",
      "description": "Your OpenAI API key for translation",
      "required": true,
      "type": "password"
    },
    {
      "name": "apiEndpoint",
      "title": "API Endpoint",
      "description": "Custom OpenAI API endpoint (optional, for compatible APIs)",
      "required": false,
      "type": "textfield",
      "default": "https://api.openai.com/v1"
    },
    {
      "name": "model",
      "title": "Model",
      "description": "OpenAI model to use for translation",
      "required": true,
      "type": "dropdown",
      "default": "gpt-4o-mini",
      "data": [
        {
          "title": "GPT-4o Mini (Recommended)",
          "value": "gpt-4o-mini"
        },
        {
          "title": "GPT-4o",
          "value": "gpt-4o"
        },
        {
          "title": "GPT-4 Turbo",
          "value": "gpt-4-turbo"
        },
        {
          "title": "GPT-3.5 Turbo",
          "value": "gpt-3.5-turbo"
        }
      ]
    },
    {
      "name": "lang1",
      "title": "Primary Language",
      "description": "Preferred language to translate from",
      "required": true,
      "type": "dropdown",
